# 使用 Apache NuttX 的 Docker 镜像作为基础镜像
FROM ghcr.io/apache/nuttx/apache-nuttx-ci-linux

# 更新包列表并安装 Open Vela Dockerfile 中独有的工具
RUN apt-get update
RUN DEBIAN_FRONTEND="noninteractive" apt-get install -y -qq \
    build-essential \
    cmake \
    git \
    libgl1-mesa-glx \
    libncurses5-dev \
    libncursesw5-dev \
    libssl-dev \
    python3 \
    python3-pip \
    curl \
    jq \
    git-lfs \
    dosfstools \
    mtools \
    libc++abi1 \
    srecord
# arch/sim links -lunwind unconditionally, and NTFC creates a virtualenv;
# the base image carries only the libunwind8 runtime and a Python without
# ensurepip. Both architectures for libunwind: seven sim configs set
# CONFIG_SIM_M32, and the package is Multi-Arch: same.
RUN dpkg --print-foreign-architectures | grep -q i386 || dpkg --add-architecture i386
RUN apt-get update
RUN DEBIAN_FRONTEND="noninteractive" apt-get install -y -qq \
    libunwind-dev \
    libunwind-dev:i386 \
    python3-venv
RUN git lfs install
RUN git lfs --version
RUN pip3 install matplotlib==3.6.2
RUN pip3 install html-table
RUN rm -rf /var/lib/apt/lists/*

# 设置容器启动时执行的命令
CMD ["/bin/bash"]
